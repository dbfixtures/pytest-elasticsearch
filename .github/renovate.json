{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "elasticsearch",
      "description": "Elasticsearch versions tested in CI, used for both the binary and the Docker image.",
      "managerFilePatterns": [
        "/^\\.github/workflows/tests\\.yml$/"
      ],
      "matchStrings": [
        "elastic-versions: '\\[[^\\]]*\\]'",
        "\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "matchStringsStrategy": "recursive"
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "packageRules": [
    {
      "enabled": false,
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ]
    }
  ]
}
